# ==============================================================================
# QR Code Platform - Environment Variables (QR-P1.0 Auth + DB Foundation)
# ==============================================================================

# Base URL used for metadata, Open Graph social cards, and NextAuth callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# NextAuth secret key (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=replace_with_a_secure_random_32_character_secret_key_minimum

# PostgreSQL connection string via Supabase connection pooler / direct connection
# Example: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres"

# Google OAuth Provider credentials (optional for credentials login, required for Google SSO)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend email API key (QR-P6.2 team invites) — get a free key at https://resend.com
# The "from" address must be verified in your Resend dashboard domain settings.
RESEND_API_KEY="re_placeholder_replace_with_real_key"
RESEND_FROM_EMAIL="invites@yourdomain.com"

# Public base URL used in invite emails — must match your deployment URL
# e.g. https://your-app.vercel.app  or  http://localhost:3000 for local dev
APP_URL="http://localhost:3000"

# Stripe Billing & Subscriptions (QR-P7.1)
# Secret key from Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY="sk_test_placeholder_replace_with_real_key"
# Webhook signing secret from Stripe Dashboard -> Developers -> Webhooks or Stripe CLI
STRIPE_WEBHOOK_SECRET="whsec_placeholder_replace_with_real_key"
# Price ID for Pro plan (recurring monthly/yearly) from Stripe Dashboard -> Products
STRIPE_PRICE_ID_PRO="price_placeholder_replace_with_real_key"

# Vercel Domains API (QR-P10.1 Custom Domain Attachment)
# Personal Access Token from Vercel Dashboard -> Account Settings -> Tokens
VERCEL_API_TOKEN="vercel_placeholder_replace_with_real_token"
# Vercel Project ID or Project Name from Project Settings -> General
VERCEL_PROJECT_ID="prj_placeholder_replace_with_real_id"
# Optional Team ID if the project belongs to a Vercel Team (leave empty for personal accounts)
VERCEL_TEAM_ID=""

# WorkOS Enterprise SSO (QR-P11.1)
# API key from WorkOS Dashboard -> API Keys
WORKOS_API_KEY="sk_placeholder_replace_with_real_key"
# Client ID / Project ID from WorkOS Dashboard -> Configuration
WORKOS_CLIENT_ID="client_placeholder_replace_with_real_id"
# Redirect URI registered in WorkOS Dashboard -> Redirects
# Must match https://yourdomain.com/api/auth/sso/callback or http://localhost:3000/api/auth/sso/callback
WORKOS_REDIRECT_URI="http://localhost:3000/api/auth/sso/callback"

