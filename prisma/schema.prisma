datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum QrType {
  STATIC
  DYNAMIC
}

model User {
  id             String       @id @default(cuid())
  name           String?
  email          String       @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships    Membership[]
  accounts       Account[]
  sessions       Session[]
  qrCodes        QrCode[]
  invitesSent    Invite[]
  apiKeys        ApiKey[]
  auditLogs      AuditLog[]

  @@map("users")
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELED
}

model Organization {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(FREE)
  workosOrganizationId String?
  ssoEnabled           Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  memberships Membership[]
  qrCodes     QrCode[]
  campaigns   Campaign[]
  invites     Invite[]
  apiKeys     ApiKey[]
  auditLogs   AuditLog[]
  customDomain CustomDomain?

  @@map("organizations")
}

model Campaign {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  qrCodes        QrCode[]

  @@index([organizationId])
  @@map("campaigns")
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  role      Role         @default(MEMBER)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([userId])
  @@index([orgId])
  @@map("memberships")
}

model Invite {
  id              String    @id @default(cuid())
  organizationId  String
  email           String
  role            Role      @default(MEMBER)
  token           String    @unique
  invitedByUserId String
  expiresAt       DateTime  // set to now()+7d on creation
  acceptedAt      DateTime? // null until accepted
  createdAt       DateTime  @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User         @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([token])
  @@map("invites")
}

model QrCode {
  id               String       @id @default(cuid())
  organizationId   String
  createdByUserId  String
  name             String
  type             QrType
  shortCode        String?      @unique
  destinationUrl   String
  isActive         Boolean      @default(true)
  scheduledStart   DateTime?    // if set and in future, redirect returns 404 (not yet live)
  expiresAt        DateTime?    // if set and in past, redirect returns 410 Gone
  styleConfig      Json?        // { fgColor, bgColor, logoUrl?, errorCorrectionLevel }
  routingRules     Json?        // { ios?: string, android?: string, desktop?: string } — DYNAMIC only
  geoRules         Json?        // { [countryCode: string]: string } e.g. { "US": "https://…" } — DYNAMIC only
  campaignId       String?      // optional FK to Campaign — SetNull on campaign delete
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser    User         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  campaign         Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  scanEvents       ScanEvent[]

  @@index([organizationId])
  @@index([createdByUserId])
  @@index([shortCode])
  @@index([campaignId])
  @@map("qr_codes")
}

model ScanEvent {
  id          String    @id @default(cuid())
  qrCodeId    String
  scannedAt   DateTime  @default(now())
  country     String?   // ISO 3166-1 alpha-2 from x-vercel-ip-country header; null locally
  deviceType  String?   // "ios" | "android" | "desktop" | "unknown"
  referrer    String?   // value of the Referer request header, if present

  qrCode      QrCode    @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@map("scan_events")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ApiKey {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  keyHash         String       @unique
  keyPrefix       String
  createdByUserId String
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyHash])
  @@map("api_keys")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User         @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model CustomDomain {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  domain           String       @unique
  verified         Boolean      @default(false)
  vercelConfigured Boolean      @default(false)
  createdAt        DateTime     @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("custom_domains")
}
